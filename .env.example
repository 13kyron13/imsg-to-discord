DISCORD_TOKEN=
CHANNEL_ID=
OWNER_ID=

# auto = macOS on Darwin, Linux on Linux
MESSAGE_BACKEND=auto

# Linux only: local iMessage backend executable
# After building with build-linux-direct.sh:
# LINUX_IMESSAGE_COMMAND=/absolute/path/to/linux-sidecar/direct-imessage/target/release/imsg-direct
LINUX_IMESSAGE_COMMAND=
# Run the direct backend in bridge mode.
LINUX_IMESSAGE_ARGS=["bridge"]

# Discord upload limit in MB
MAX_UPLOAD_MB=9.5

# Linux direct backend attachment limits
IMSG_RUSTPUSH_MAX_ATTACHMENT_MB=100
IMSG_RUSTPUSH_MAX_ATTACHMENTS=10
IMSG_RUSTPUSH_ATTACHMENT_MAX_AGE_HOURS=24
